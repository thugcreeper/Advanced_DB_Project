# Existing Aura names are supported; no credentials belong in Git.
AURA_CONNECTION_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
AURA_PASSWD=
# Optional instance metadata only, never used as database or username:
AURA_DB_NAME=
AURA_DB_ID=
NEO4J_USERNAME=YOUR_DATABASE_USER
NEO4J_DATABASE=YOUR_DATABASE_NAME
# Process NEO4J_URI / NEO4J_PASSWORD override local dotenv settings.
# Within dotenv, Aura names supersede legacy local NEO4J_URI / NEO4J_PASSWORD.
# Render injects PORT. Optional: SERVER_ADDRESS=0.0.0.0
# Set CORS_ALLOWED_ORIGINS in the process environment for a separate frontend.
